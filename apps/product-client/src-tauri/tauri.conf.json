{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nolane",
  "version": "1.0.1",
  "identifier": "ai.nolane.personal",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nolane",
        "width": 1040,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe\u002dinline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/runtime/**/*",
      "resources/model/**/*",
      "resources/tokenizer/**/*",
      "resources/mobile/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "bundleVCRuntime": true,
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
